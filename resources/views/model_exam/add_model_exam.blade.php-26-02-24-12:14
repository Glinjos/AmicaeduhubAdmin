            <script>
                var uniqueSubmoduleIds = new Set(); // Keep track of unique submodule IDs
                var checkedSubmoduleIds = []; // Declare the variable in the outer scope
            
                function checkboxSubmoduleValidation() {
                    var selectedModules = [];
            
                    $('input[name="moduleId[]"]:checked').each(function () {
                        selectedModules.push($(this).val());
                    });
                   // console.log('selectedModules:',selectedModules);
            
                    // Clear submodule-related data if no modules are selected
                    if (selectedModules.length === 0) {
                        clearSubmodules();
                        return;
                    }
            
                    // Modules that were selected previously but are not selected now
                    var modulesToRemove = checkedSubmoduleIds.filter(submoduleId => !selectedModules.includes(submoduleId.split('_')[0]));
            
                    // Remove submodules for modules that are no longer selected
                    removeSubmodules(modulesToRemove);
            
                    // Load submodules for newly selected modules
                    loadSubmodules(selectedModules);
                }
            
                function removeSubmodules(modulesToRemove) {
                    modulesToRemove.forEach(function (submoduleId) {
                        // Remove submodule HTML elements for the specified module
                        $('#submodulesDiv1 input[data-submodule="' + submoduleId + '"]').closest('.form-check').remove();
                        $('#submodulesDiv2 input[data-submodule="' + submoduleId + '"]').closest('.form-check').remove();
            
                        // Remove the submodule from the checkedSubmoduleIds array
                        checkedSubmoduleIds = checkedSubmoduleIds.filter(submodule => submodule !== submoduleId);
                    });
                }
            
                function clearSubmodules() {
                    // Remove all submodule HTML elements
                    $('#submodulesDiv1').empty();
                    $('#submodulesDiv2').empty();
                    document.getElementById("mainsubmodulediv").style.display = 'none';
                    
                    //clear the questions toooo
                    $('#questDiv1').empty();
                    $('#questDiv2').empty();
                    document.getElementById("mainQUESTdiv").style.display = 'none';
            
                    // Clear the checkedSubmoduleIds array
                    checkedSubmoduleIds = [];
                }
            
                function loadSubmodules(moduleIds) {
                    moduleIds.forEach(function (moduleId) {
                        $.ajax({
                            url: "{{url('/ChapterWisemodelexmmodulecheck')}}",
                            type: "POST",
                            data: {
                                mId: moduleId,
                                _token: '{{csrf_token()}}'
                            },
                            success: function (result) {
                                if (result) {
                                    $.each(result, function (key, value) {
                                        var submoduleId = moduleId + '_' + value.smId;
            
                                        // Check if the submodule ID is unique before adding to HTML
                                        if (!checkedSubmoduleIds.includes(submoduleId)) {
                                            checkedSubmoduleIds.push(submoduleId);
            
                                            // Determine the appropriate div based on the key
                                            var submoduleDiv = (key % 2 === 0) ? '#submodulesDiv1' : '#submodulesDiv2';
            
                                            // Append the submodule HTML to the selected div
                                            $(submoduleDiv).append('<div class="form-check">'
                                                + '<input type="checkbox" id="submoduleId_' + submoduleId + '" value="' + submoduleId + '" name="submoduleId[]" data-submodule="' + submoduleId + '" class="form-check-input" onclick="checkboxValidation();checkboxQuestionValidation();">'
                                                + '<label for="submoduleId_' + submoduleId + '" class="form-check-label">' + value.smName + '</label>'
                                                + '</div>');
                                        }
                                    });
            
                                   // console.log("Checked Submodule IDs:", checkedSubmoduleIds);
                                }
                            },
                            complete: function () {
                                // Show/hide elements as needed
                                $('#submodulesDiv1').show();
                                $('#submodulesDiv2').show();
                                document.getElementById("mainsubmodulediv").style.display = 'block';
                            }
                        });
                    });
                }
            
                // Function to handle checkbox validation when a submodule checkbox is unchecked
                function checkboxValidation() {
                    // Clear the checkedSubmoduleIds array
                    checkedSubmoduleIds = [];
            
                    // Iterate over all submodule checkboxes
                    $('input[name="submoduleId[]"]').each(function () {
                        var submoduleCheckbox = $(this);
                        var submoduleId = submoduleCheckbox.val();
            
                        // If the checkbox is checked, add it to the checkedSubmoduleIds array
                        if (submoduleCheckbox.is(':checked')) {
                            checkedSubmoduleIds.push(submoduleId);
                        }
                    });
            
                  //  console.log("Checked Submodule IDs:", checkedSubmoduleIds);
                }
            </script>
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
               
           
         
            
            
            
            
            
            
              
            
            
            
