<script>
    function EditerQUESTION() {
      //  console.log("EditerQUESTION load:");
        var newlySelectedSubmodules1 = [];

        $('input[name="submoduleId[]"]:checked').each(function () {
            var submoduleParts = $(this).val().split('_');
            var numericalId = submoduleParts.length === 2 ? submoduleParts[1] : null;
            var smNameid = $(this).val();

            if (numericalId !== null) {
                var labelForId = 'submoduleId_' + smNameid;
                var labelElement = $('label[for="' + labelForId + '"]');
                var smName = labelElement.text();

                newlySelectedSubmodules1.push({
                    id: numericalId,
                    smName: smName
                });
            }
        });

       // console.log("newlySelectedSubmodules1:", newlySelectedSubmodules1);

        // Clear previous questions before loading new ones
        clearQuestions1(selectedSubmodules);

        // Load questions for newly checked submodules
        loadQuestions1(newlySelectedSubmodules1);

        // Update the selectedSubmodules list
        selectedSubmodules = newlySelectedSubmodules1;
        
         updateCheckedQuestionCount();
    }

    function clearQuestions1(submodulesToClear) {
        submodulesToClear.forEach(function (submodule) {
            // Remove question HTML elements for the specified submodule
            $('#questDiv1 input[data-submodule="' + submodule.id + '"]').closest('.form-check').remove();
            $('#questDiv2 input[data-submodule="' + submodule.id + '"]').closest('.form-check').remove();
            $('#questDiv1 label.submodule-label[data-submodule="' + submodule.id + '"]').remove();
        });

        // Empty the questDiv1 element
        $('#questDiv1').empty();
        // Empty the questDiv2 element (assuming it is also meant to be cleared)
        $('#questDiv2').empty();
    }

    function loadQuestions1(newlySelectedSubmodules1) {
       // console.log('load---newlySelectedSubmodules1', newlySelectedSubmodules1)

        newlySelectedSubmodules1.forEach(function (submodule) {
            $.ajax({
                url: "{{url('/modelexmreturnquest')}}",
                type: "get",
                data: {
                    smId: submodule.id,
                    _token: '{{csrf_token()}}'
                },
                success: function (result) {
                    if (result && result.length > 0) {
                        var questionDiv = '#questDiv1';

                        $(questionDiv).append('<label class="submodule-label" data-submodule="' + submodule.id + '" style="font-weight: bold; color: black;"><b>' + submodule.smName + '</b></label>');

                        result.forEach(function (value) {
                            $(questionDiv).append('<div class="form-check">'
                                + '<input type="checkbox" id="questId_' + submodule.id + '_' + value.cqId + '" value="' + value.cqId + '" name="questionId[]" data-submodule="' + submodule.id + '" class="form-check-input" onclick="checkboxQuestionValidation();">'
                                + '<label for="questId_' + submodule.id + '_' + value.cqId + '" class="form-check-label">' + value.question + '</label>'

                                + '<abbr style="text-decoration: none;" title="Edit "><span style="text-decoration: none;color: #007bff;"><span class="fe fe-24 fe-edit" onclick="return updateForm(' + value.cqId +')"></span></abbr>'

                                + '</div>');

                        });
                    } else {
                        alert('There are no questions in your selected submodule.');
                    }
                },
                complete: function () {
                    // Show/hide elements as needed
                    $('#questDiv1').show();
                    $('#questDiv2').show();
                    document.getElementById("mainQUESTdiv").style.display = 'block';
                }
            });
        });
    }
</script>


