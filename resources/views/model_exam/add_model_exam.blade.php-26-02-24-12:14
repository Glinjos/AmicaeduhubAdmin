        $('input[name="submoduleId[]"]:checked').each(function () {
        var submoduleParts = $(this).val().split('_');
        var numericalId = submoduleParts.length === 2 ? submoduleParts[1] : null;
        var smNameid = $(this).val();

            if (numericalId !== null) {
                var labelForId = 'submoduleId_' + smNameid;
                var labelElement = $('label[for="' + labelForId + '"]');
              //  console.log("numericalId:", numericalId, "labelElement:", labelElement);

                var smName = labelElement.text();
                //console.log("smName:", smName);

                newlySelectedSubmodules.push({
                    id: numericalId,
                    smName: smName
                });
            }
        });

       // console.log("newlySelectedSubmodules:", newlySelectedSubmodules);
       

        var submodulesToLoad = newlySelectedSubmodules.filter(submodule => !selectedSubmodules.some(s => s.id === submodule.id));
        var submodulesToClear = selectedSubmodules.filter(submodule => !newlySelectedSubmodules.some(s => s.id === submodule.id));

        // Clear questions for submodules that are unchecked
        clearQuestions(submodulesToClear);

        // Load questions for newly checked submodules
        loadQuestions(submodulesToLoad);

        // Update the selectedSubmodules list
        selectedSubmodules = newlySelectedSubmodules;
       // console.log('selectedSubmodules:',selectedSubmodules);
       
       updateCheckedQuestionCount();
       
    }

    function clearQuestions(submodulesToClear) {
        submodulesToClear.forEach(function (submodule) {
            // Remove question HTML elements for the specified submodule
            $('#questDiv1 input[data-submodule="' + submodule.id + '"]').closest('.form-check').remove();
            $('#questDiv2 input[data-submodule="' + submodule.id + '"]').closest('.form-check').remove();
            $('#questDiv1 label.submodule-label[data-submodule="' + submodule.id + '"]').remove();
        });
    }

    function loadQuestions(submodulesToLoad) {
        submodulesToLoad.forEach(function (submodule) {
            $.ajax({
                url: "{{url('/modelexmreturnquest')}}",
                type: "get",
                data: {
                    smId: submodule.id,
                    _token: '{{csrf_token()}}'
                },
                success: function (result) {
                    if (result && result.length > 0) {
                        var questionDiv = '#questDiv1';
                        $(questionDiv).append('<label class="submodule-label" data-submodule="' + submodule.id + '" style="font-weight: bold; color: black;"><b>' + submodule.smName + '</b></label>');

